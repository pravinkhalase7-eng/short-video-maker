# Short Video Maker — VPS / Jenkins deploy env
# Create Jenkins credential:
#   Kind: Secret file
#   ID:   shortvideo-env-file
#   File: copy of this (filled in)

# --- Compose / host ports ---
APP_HOST_PORT=3123

# Required
PEXELS_API_KEY=

# Optional stock + script generation
PIXABAY_API_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Runtime (keep these for Docker)
PORT=3123
DEV=false
DOCKER=true
LOG_LEVEL=info
CONCURRENCY=1
WHISPER_MODEL=tiny.en
KOKORO_MODEL_PRECISION=q4
DATA_DIR_PATH=/app/data
VIDEO_CACHE_SIZE_IN_BYTES=2097152000
