PEXELS_API_KEY= # crucial for the project to work
PIXABAY_API_KEY= # optional fallback for stock videos and photos: https://pixabay.com/api/docs/
LOG_LEVEL=trace # trace, debug, info, warn, error, fatal, silent
CONCURRENCY= # optional. local default is 2-4. keep 1 in Docker.
WHISPER_VERBOSE=true
PORT=3123
DEV=true # local development mode
DATA_DIR_PATH= # only for docker, otherwise leave empty
GEMINI_API_KEY= # optional, used to generate scenes from a text prompt
GEMINI_MODEL=gemini-2.5-flash
